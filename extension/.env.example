# ---------------------------------------------------------------------------
# Threadwise Companion environment
# Copy to `.env` (ignored by git) and adjust.
# With no API base URL the extension uses the bundled demo dataset.
# ---------------------------------------------------------------------------

# Threadwise REST API - the SAME backend the web app uses. No trailing slash.
# VITE_API_BASE_URL=https://api.threadwise.app

# Public web app URL, used for "open in Threadwise" links.
# VITE_APP_WEB_URL=https://threadwise.app

# Force the bundled mock API on/off. Defaults to true when no base URL is set.
# VITE_USE_MOCK_API=true

# Request timeout in milliseconds.
# VITE_API_TIMEOUT_MS=15000

# Server-Sent Events endpoint for real-time updates. Empty disables the feed.
# VITE_REALTIME_URL=https://api.threadwise.app/events