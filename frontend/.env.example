# ---------------------------------------------------------------------------
# Friday frontend environment
# Copy to `.env.local` and adjust. All values are optional: with no API base
# URL the app runs against the bundled demo dataset (src/mocks).
# ---------------------------------------------------------------------------

# Friday REST API (docs/08_system_architecture.md). No trailing slash.
# VITE_API_BASE_URL=https://api.friday.app

# Public web app URL, used for share/deep links.
# VITE_APP_WEB_URL=https://friday.app

# Force the bundled mock API on/off. Defaults to true when VITE_API_BASE_URL is empty.
# VITE_USE_MOCK_API=true

# Request timeout in milliseconds.
# VITE_API_TIMEOUT_MS=20000

# Server-Sent Events endpoint for real-time updates. Empty disables the feed.
# VITE_REALTIME_URL=https://api.friday.app/events

# Web Push public key (VAPID). Required for push notifications.
# VITE_VAPID_PUBLIC_KEY=

# Auth provider: 'clerk' for the hosted flow, 'local' for the built-in session store.
# VITE_AUTH_PROVIDER=local
